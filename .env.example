APP_NAME="Sistem e-Perolehan Universal"
APP_ENV=local
APP_KEY=base64:Y+EnZq93B2jb4PrubbAtnV01ICbLH/Fao8hbqhpcV3s=
APP_DEBUG=true
APP_URL=https://lpku.pats.my

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi Pangkalan Data (SQLite untuk local testing / MariaDB 11 untuk pengeluaran aaPanel)
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=eperolehan
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="perolehan@organisasi.my"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi MinIO S3 (Docker) untuk Arkib Storan Sejuk (Cold Storage)
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=eperolehan-archive
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Konfigurasi Gerbang Pembayaran AffanPay (maui2023/affanpay-laravel)
AFFANPAY_ENVIRONMENT=sandbox
AFFANPAY_WEBHOOK_SECRET=affanpay_secret_token_12345
AFFANPAY_SANDBOX_URL=https://sandbox.affanpay.my
AFFANPAY_SANDBOX_EMAIL=admin@organisasi.my
AFFANPAY_SANDBOX_PASSWORD=secret
AFFANPAY_LIVE_URL=https://app.affanpay.my
AFFANPAY_LIVE_EMAIL=
AFFANPAY_LIVE_PASSWORD=
AFFANPAY_SIMULATION_MODE=true

VITE_APP_NAME="${APP_NAME}"
